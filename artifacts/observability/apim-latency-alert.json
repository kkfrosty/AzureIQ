{
  "id": "observability.apim-latency-alert",
  "version": "0.1.0",
  "summary": "Alert on APIM gateway p95 total duration above an approved millisecond threshold with a minimum traffic guard. Uses the existing workspace and action group; incurs alert-query cost.",
  "verification": "Independently verify TotalTime is milliseconds in the actual schema, compare measured p95 with the approved SLO, and test idle/low-volume behavior and action delivery.",
  "parameters": {
    "resourceGroup": { "type": "string", "pattern": "^[A-Za-z0-9_.()-]{1,90}$" },
    "serviceName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,49}$" },
    "alertName": { "type": "string", "pattern": "^[A-Za-z0-9_.()-]{1,90}$" },
    "location": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,30}$" },
    "thresholdMilliseconds": { "type": "number", "minimum": 1, "maximum": 3600000 },
    "minimumRequests": { "type": "number", "minimum": 1, "maximum": 1000000 },
    "workspaceResourceId": { "type": "string", "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[A-Za-z0-9_.()-]{1,90}/providers/Microsoft\\.OperationalInsights/workspaces/[A-Za-z0-9-]{1,63}$" },
    "actionGroupResourceId": { "type": "string", "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[A-Za-z0-9_.()-]{1,90}/providers/Microsoft\\.Insights/actionGroups/[A-Za-z0-9_.()-]{1,90}$" }
  },
  "target": "/subscriptions/{{subscriptionId}}/resourceGroups/{{resourceGroup}}/providers/Microsoft.Insights/scheduledQueryRules/{{alertName}}",
  "apiVersion": "2023-12-01",
  "checks": [
    { "target": "/subscriptions/{{subscriptionId}}/resourceGroups/{{resourceGroup}}/providers/Microsoft.ApiManagement/service/{{serviceName}}", "apiVersion": "2024-05-01", "expected": { "properties": { "provisioningState": "Succeeded" } } },
    { "target": "{{workspaceResourceId}}", "apiVersion": "2022-10-01", "expected": {} },
    { "target": "{{actionGroupResourceId}}", "apiVersion": "2023-01-01", "expected": { "properties": { "enabled": true } } }
  ],
  "body": {
    "location": "{{location}}",
    "properties": {
      "displayName": "APIM gateway tail latency",
      "enabled": true,
      "severity": 2,
      "scopes": ["{{workspaceResourceId}}"],
      "evaluationFrequency": "PT5M",
      "windowSize": "PT15M",
      "autoMitigate": true,
      "criteria": {
        "allOf": [{
          "query": "ApiManagementGatewayLogs | where TimeGenerated > ago(15m) | where _ResourceId =~ '/subscriptions/{{subscriptionId}}/resourceGroups/{{resourceGroup}}/providers/Microsoft.ApiManagement/service/{{serviceName}}' | summarize Requests=count(), P95Milliseconds=percentile(TotalTime,95) | where Requests >= {{minimumRequests}} and P95Milliseconds > {{thresholdMilliseconds}}",
          "timeAggregation": "Count",
          "operator": "GreaterThan",
          "threshold": 0,
          "failingPeriods": { "numberOfEvaluationPeriods": 1, "minFailingPeriodsToAlert": 1 }
        }]
      },
      "actions": { "actionGroups": ["{{actionGroupResourceId}}"] }
    }
  }
}
