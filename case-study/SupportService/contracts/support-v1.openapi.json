    "/voice/socket": {
      "get": {
        "tags": [
          "Voice"
        ],
        "description": "Private WSS /voice/socket?sessionId=<opaque-id>; fixed APIM handshake /support/voice?sessionId=<opaque-id>. Backend gateway JWT plus approved Origin and Sec-WebSocket-Protocol: harbor.voice.v1, harbor.ticket.<opaque-ticket>. Only the non-secret sessionId is permitted in the URL.",
        "operationId": "ConnectVoiceRelay",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols"
          }
        },
        "security": [
          {
            "gatewayBearer": [ ]
          }
        ]
      }
    },
