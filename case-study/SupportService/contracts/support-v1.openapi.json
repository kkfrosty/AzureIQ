      "post": {
        "tags": [
          "Cases"
        ],
        "description": "Requires exact proposalHash, a separate human confirmation grant, and a GUID Idempotency-Key header. Exact retries return the original case.",
        "operationId": "CommitConfirmedCase",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
