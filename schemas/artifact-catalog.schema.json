{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azureiq.local/schemas/artifact-catalog.schema.json",
  "title": "AzureIQ Reusable Artifact Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "artifacts"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedStatus", "executionRequiresCatalog", "privateBindings", "localRunLedger"],
      "properties": {
        "generatedStatus": { "const": "candidate" },
        "executionRequiresCatalog": { "const": true },
        "privateBindings": { "type": "string", "minLength": 1 },
        "localRunLedger": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "executionMode",
        "status",
        "valueProof",
        "description",
        "intents",
        "source",
        "compatibility",
        "parameters",
        "decisionPoints",
        "validation",
        "reuse",
        "owners",
        "supersedes",
        "supersededBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "bicep-module",
            "arm-template",
            "template-spec",
            "deployment-stack",
            "cli-operation",
            "cli-workflow",
            "rest-workflow",
            "apim-policy",
            "kql-query",
            "alert-rule",
            "dashboard",
            "runbook",
            "verification",
            "test"
          ]
        },
        "executionMode": {
          "type": "string",
          "enum": ["declarative", "imperative", "read-only", "workflow"]
        },
        "status": {
          "type": "string",
          "enum": ["candidate", "draft", "validated", "approved", "deprecated", "retired"]
        },
        "valueProof": {
          "type": "string",
          "enum": ["unproven", "value-demonstrated", "no-value"]
        },
        "description": { "type": "string", "minLength": 1 },
        "intents": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "entryPoint"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "entryPoint": { "type": ["string", "null"] }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceTypes", "clouds", "environments", "conditions"],
          "properties": {
            "resourceTypes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "clouds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "environments": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "conditions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required", "sensitive", "source"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "sensitive": { "type": "boolean" },
              "source": {
                "type": "string",
                "enum": ["approved-manifest", "private-config", "key-vault", "artifact-default", "derived"]
              }
            }
          }
        },
        "decisionPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "condition", "question", "severity", "canInfer"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "condition": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "enum": ["advisory", "approval", "blocker"] },
              "canInfer": { "type": "boolean" }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "lastValidatedAt", "expiresAt", "methods", "evidenceRefs"],
          "properties": {
            "level": { "type": "string", "enum": ["none", "static", "live-read", "live-write"] },
            "lastValidatedAt": { "type": ["string", "null"], "format": "date" },
            "expiresAt": { "type": ["string", "null"], "format": "date" },
            "methods": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "evidenceRefs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reuse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "revalidateWhen", "updatePolicy"],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": ["exact", "parameterize", "compose", "adapt", "reference-only"]
            },
            "revalidateWhen": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "updatePolicy": { "type": "string", "minLength": 1 }
          }
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "supersededBy": { "type": ["string", "null"] }
      }
    }
  }
}