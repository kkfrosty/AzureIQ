{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azureiq.local/schemas/expected-inventory.schema.json",
  "title": "AzureIQ Expected Environment Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "environmentBoundary",
    "requiredOwnershipTags",
    "resources",
    "allowedChildResourcePrefixes",
    "externalResources",
    "teardownBlockers",
    "softDelete"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "environmentBoundary": {
      "const": "resource-group"
    },
    "requiredOwnershipTags": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "managedBy",
        "lifecycle",
        "caseStudy"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "count"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.]+/[A-Za-z0-9./]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "sourceOutput": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          }
        }
      }
    },
    "allowedChildResourcePrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "externalResources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "scope",
          "count",
          "deleteBeforeBoundary"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.]+/[A-Za-z0-9./]+$"
          },
          "scope": {
            "const": "subscription"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "deleteBeforeBoundary": {
            "const": true
          }
        }
      }
    },
    "teardownBlockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "softDelete": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retentionHours",
          "purgeRequiresSeparateApproval",
          "nextRunUsesUniqueEnvironmentId"
        ],
        "properties": {
          "retentionHours": {
            "type": "integer",
            "minimum": 1
          },
          "purgeRequiresSeparateApproval": {
            "const": true
          },
          "nextRunUsesUniqueEnvironmentId": {
            "const": true
          }
        }
      }
    }
  }
}