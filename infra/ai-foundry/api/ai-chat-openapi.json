{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Foundry Chat Gateway",
    "version": "1.0.0",
    "description": "Minimal Azure OpenAI chat surface exposed through API Management as a protected AI gateway."
  },
  "paths": {
    "/deployments/{deployment-id}/chat/completions": {
      "post": {
        "operationId": "ChatCompletions",
        "summary": "Create a chat completion for a deployed model",
        "tags": [
          "Chat"
        ],
        "parameters": [
          {
            "name": "deployment-id",
            "in": "path",
            "required": true,
            "description": "Name of the model deployment to invoke.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "api-version",
            "in": "query",
            "required": true,
            "description": "Azure OpenAI data plane API version.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion produced by the model.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "The request was rejected by the gateway or the model."
          },
          "401": {
            "description": "The caller did not present a valid gateway subscription key."
          },
          "429": {
            "description": "The caller exceeded a request or token rate limit."
          },
          "500": {
            "description": "The gateway or model failed to complete the request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "messages"
        ],
        "additionalProperties": true,
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "temperature": {
            "type": "number"
          },
          "stream": {
            "type": "boolean"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Chat"
    }
  ]
}
